# Toggle demo mode for local/hackathon demos without live Auth0 setup
DEMO_MODE=false

# Auth0 Configuration
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_SECRET=random-32-byte-hex-value
AUTH0_AUDIENCE=https://your-api-audience
AUTH0_CUSTOM_API_CLIENT_ID=your-custom-api-client-id
AUTH0_CUSTOM_API_CLIENT_SECRET=your-custom-api-client-secret

# Groq
GROQ_API_KEY=gsk-your-groq-api-key

# Optional provider tokens for live mode
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
GITHUB_TOKEN=ghp-your-github-token
SLACK_BOT_TOKEN=xoxb-your-slack-token

# App
APP_BASE_URL=http://localhost:3000
